# Copy to .env and fill in what you use. Nothing here is required for `npm test`.
# The browser extension does NOT read this file — configure it in the popup.

# --- Eval suite (`npm run eval`) -------------------------------------------
# Shortcut: NVIDIA NIM (free tier) or Anthropic.
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
ANTHROPIC_API_KEY=

# Or pick any provider from packages/core/src/prompt-helper/providers.ts:
# PF_PROVIDER=ollama
# PF_MODEL=llama3.1:8b
# PF_API_KEY=
# PF_BASE_URL=http://localhost:11434/v1

# --- Optional hosted-mode proxy (`npm run dev --workspace apps/backend`) ----
# Server-side key used when the caller sends none. <PROVIDER>_API_KEY or PF_API_KEY.
PORT=3000

# --- CLI / VS Code shells: where the hosted proxy lives --------------------
PF_API=http://localhost:3000/api/rewrite

# --- Dashboard: backend base URL for synced events (falls back to demo data) -
PF_BACKEND=

# --- Optional Headroom proxy for the live check (`npm run e2e:headroom`) ------
# The extension reads its own setting from the popup, not this file.
PF_HEADROOM_URL=http://127.0.0.1:8787
