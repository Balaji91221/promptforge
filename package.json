{
  "name": "promptforge",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-provider prompt-engineering assistant: rewrites messy input into a clear prompt on Claude, ChatGPT, Gemini, Grok and Perplexity.",
  "license": "MIT",
  "author": "Balaji91221",
  "homepage": "https://github.com/Balaji91221/promptforge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Balaji91221/promptforge.git"
  },
  "bugs": {
    "url": "https://github.com/Balaji91221/promptforge/issues"
  },
  "keywords": [
    "prompt-engineering",
    "llm",
    "chrome-extension",
    "claude",
    "chatgpt",
    "gemini",
    "openai",
    "anthropic",
    "ollama",
    "typescript",
    "monorepo"
  ],
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:engine": "tsc -b packages/types packages/core packages/adapters",
    "typecheck": "tsc -b && npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build:engine && tsx evals/e2e-extension.ts",
    "e2e:headroom": "npm run build:engine && tsx evals/headroom-live.ts",
    "eval": "tsx evals/runner.ts",
    "dev:ext": "npm run dev --workspace apps/extension-browser",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo apps/*/dist apps/*/.next",
    "e2e:mcp": "npm run build:engine && npm run build --workspace apps/mcp && tsx evals/e2e-mcp.ts",
    "deadcode": "knip"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@promptforge/core": "*",
    "@promptforge/types": "*",
    "eslint": "^10.12.0",
    "globals": "^17.12.0",
    "knip": "^5.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
