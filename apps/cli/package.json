{
  "name": "@promptforge/cli",
  "version": "0.0.1",
  "type": "module",
  "description": "Legacy PTY shim that wraps Codex/Gemini/Grok/Claude Code. Prefer apps/mcp (MCP server) for coding agents.",
  "bin": {
    "promptforge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p .",
    "start": "tsx src/index.ts",
    "typecheck": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@promptforge/core": "*",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
